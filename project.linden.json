  "input": {
    "actions": [
      {
        "name": "Move",
        "type": "vector2",
        "bindings": [
          "Gamepad/LeftStick",
          "Touch/Joystick"
        ],
        "composites": [
          {
            "up": [
              "Keyboard/KeyW"
            ],
            "down": [
              "Keyboard/KeyS"
            ],
            "left": [
              "Keyboard/KeyA"
            ],
            "right": [
              "Keyboard/KeyD"
            ]
          },
          {
            "up": [
              "Keyboard/ArrowUp"
            ],
            "down": [
              "Keyboard/ArrowDown"
            ],
            "left": [
              "Keyboard/ArrowLeft"
            ],
            "right": [
              "Keyboard/ArrowRight"
            ]
          }
        ],
        "deadzone": 0.15
      },
      {
        "name": "Turn",
        "type": "axis",
        "bindings": [],
        "composites": [
          {
            "negative": [
              "Keyboard/KeyQ",
              "Gamepad/LeftShoulder"
            ],
            "positive": [
              "Keyboard/KeyE",
              "Gamepad/RightShoulder"
            ]
          }
        ]
      },
      {
        "name": "Vertical",
        "type": "axis",
        "bindings": [],
        "composites": [
          {
            "negative": [
              "Keyboard/KeyQ",
              "Gamepad/LeftTrigger"
            ],
            "positive": [
              "Keyboard/KeyE",
              "Gamepad/RightTrigger"
            ]
          }
        ]
      },
      {
        "name": "Look",
        "type": "vector2",
        "bindings": [
          "Mouse/Delta",
          "Gamepad/RightStick",
          "Touch/Look"
        ],
        "deadzone": 0.15,
        "sensitivity": 1
      },
      {
        "name": "Jump",
        "type": "button",
        "bindings": [
          "Keyboard/Space",
          "Gamepad/ButtonSouth"
        ]
      },
      {
        "name": "Sprint",
        "type": "button",
        "bindings": [
          "Keyboard/ShiftLeft",
          "Gamepad/LeftStickPress",
          "Touch/Joystick"
        ],
        "pressThreshold": 0.9
      },
      {
        "name": "Crouch",
        "type": "button",
        "bindings": [
          "Keyboard/KeyC",
          "Keyboard/ControlLeft",
          "Gamepad/ButtonEast"
        ]
      },
      {
        "name": "Interact",
        "type": "button",
        "bindings": [
          "Keyboard/KeyF",
          "Gamepad/ButtonWest"
        ]
      },
      {
        "name": "Attack",
        "type": "button",
        "bindings": [
          "Mouse/LeftButton",
          "Gamepad/ButtonNorth",
          "Gamepad/RightTrigger"
        ]
      }
    ],
    "touch": {
      "enabled": "auto",
      "joystick": {
        "side": "left",
        "mode": "floating",
        "radius": 64
      },
      "look": {
        "enabled": true,
        "area": "right-half",
        "sensitivity": 1
      },
      "opacity": 0.6,
      "safeArea": true,
      "scale": "auto",
      "buttons": [
        {
          "id": "Jump",
          "action": "Jump",
          "label": "FLAP",
          "icon": "jump",
          "behavior": "tap",
          "anchor": "bottom-right",
          "unit": "px",
          "x": 30,
          "y": 40,
          "size": 104,
          "shape": "circle",
          "color": "#ffd93d",
          "pressedColor": "#f0b429",
          "textColor": "#123b4f"
        }
      ]
    }
  },
  "services": [],
  "scenesInBuild": [
    "scenes/Main.lscene"
  ],
  "exportPresets": [
    {
      "id": "preset-windows-desktop",
      "name": "Windows Desktop",
      "platform": "windows",
      "backend": "linden",
      "arch": [
        "x64"
      ],
      "output": "build/windows/FlappyFlight.exe",
      "mode": "release",
      "appName": "FlappyFlight"
    },
    {
      "id": "preset-macos-desktop",
      "name": "macOS",
      "platform": "macos",
      "backend": "linden",
      "arch": [
        "universal"
      ],
      "output": "build/mac/FlappyFlight.dmg",
      "mode": "release",
      "appName": "FlappyFlight"
    },
    {
      "id": "preset-linux-desktop",
      "name": "Linux",
      "platform": "linux",
      "backend": "linden",
      "arch": [
        "x64"
      ],
      "output": "build/linux/FlappyFlight.AppImage",
      "mode": "release",
      "appName": "FlappyFlight"
    },
    {
      "id": "preset-web-html5",
      "name": "Web",
      "platform": "web",
      "backend": "linden",
      "arch": [
        "wasm"
      ],
      "output": "build/web/index.html",
      "mode": "release",
      "appName": "FlappyFlight"
    },
    {
      "id": "preset-android",
      "name": "Android",
      "platform": "android",
      "backend": "godot",
      "arch": [
        "arm64"
      ],
      "output": "build/android/FlappyFlight.apk",
      "mode": "debug",
      "appName": "FlappyFlight"
    },
    {
      "id": "preset-ios",
      "name": "iOS",
      "platform": "ios",
      "backend": "godot",
      "arch": [
        "arm64"
      ],
      "output": "build/ios/FlappyFlight.ipa",
      "mode": "debug",
      "appName": "FlappyFlight"
    }
  ]
}